# Copy to .env and fill in. Never commit .env itself — it is in .gitignore.
#
# In CI these values are not taken from a file in the repository at all. They
# arrive as GitLab *File*-type CI/CD variables and are written to the deploy
# host by the pipeline, so access to production secrets is separate from
# access to the code.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/app
SECRET_KEY=replace-with-a-long-random-value
HOST_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Frontend (build-time — Vite inlines VITE_* into the bundle)
# ---------------------------------------------------------------------------
VITE_API_BASE=http://localhost:8000
